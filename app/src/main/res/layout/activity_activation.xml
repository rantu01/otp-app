<?xml version="1.0" encoding="utf-8"?>
<!-- First-run App/Device Activation screen (styled after the Kewa reference:
     white header card, dark navy body, white footer with EXIT / next). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#757575"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/actCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="Nesa Activation"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B1233"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 App Security Locked"
                android:textColor="#6FB1E8"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Your Device ID (Tap to Copy):"
                android:textColor="#6FB1E8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/deviceIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true"
                android:text="—"
                android:textColor="#6FB1E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/deviceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:hint="Enter Device ID manually (if needed)"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="#2D2A4A"
                android:textColorHint="#8A8F98"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Server URL (e.g. http://10.0.2.2:4000)"
                android:inputType="textUri"
                android:padding="10dp"
                android:textColor="#2D2A4A"
                android:textColorHint="#8A8F98"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/actHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#9FB6D8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="right|center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <Button
                android:id="@+id/exitBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXIT"
                android:textColor="#0B7285"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextBtn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="28dp"
                android:text="next"
                android:textColor="#8A6D00"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
