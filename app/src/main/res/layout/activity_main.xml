<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="rantuOTP"
            android:textColor="@color/title_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Server card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bridge Server (:3000)"
                android:textColor="@color/title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/serverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="○ Server STOPPED"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/serverToggleBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Start Server" />

            <ScrollView
                android:id="@+id/serverLogScroll"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="6dp"
                android:background="@color/log_bg">

                <TextView
                    android:id="@+id/serverLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="Server log...\n"
                    android:textColor="@color/log_text"
                    android:textSize="10sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabOtpBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OTP Fetcher" />

            <Button
                android:id="@+id/tabNameBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:alpha="0.5"
                android:text="US Name Gen" />
        </LinearLayout>

        <!-- TAB 1: OTP -->
        <LinearLayout
            android:id="@+id/tabOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="10dp">

            <EditText
                android:id="@+id/accountData"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@android:drawable/edit_text"
                android:gravity="top"
                android:hint="Paste Account Data (Email|RefreshToken|ClientId)..."
                android:inputType="textMultiLine"
                android:textColor="@color/title_text"
                android:textColorHint="@color/title_text"
                android:padding="6dp"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/emailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/info_bg"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/extractedEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/accent_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyEmailBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Copy Email" />
            </LinearLayout>

            <Button
                android:id="@+id/getCodeBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="GET CODE" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/info_bg"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="OTP Code:"
                    android:textColor="@color/title_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/otpCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="------"
                    android:textColor="@color/otp_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyCodeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Copy Code" />
            </LinearLayout>

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/danger"
                android:text="Clear Saved Data" />
        </LinearLayout>

        <!-- TAB 2: Name generator -->
        <LinearLayout
            android:id="@+id/tabName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/genderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/genderMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Male"
                    android:textColor="@color/title_text" />

                <RadioButton
                    android:id="@+id/genderFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Female"
                    android:textColor="@color/title_text" />

                <RadioButton
                    android:id="@+id/genderBoth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Random"
                    android:textColor="@color/title_text" />
            </RadioGroup>

            <Button
                android:id="@+id/genNameBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Generate Name" />

            <LinearLayout
                android:id="@+id/nameContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/info_bg"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/generatedName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="---"
                    android:textColor="@color/accent_blue"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyNameBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Copy Name" />

                <Button
                    android:id="@+id/copyNameSplitBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Copy First, Last" />
            </LinearLayout>

            <TextView
                android:id="@+id/nameStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Floating + Exit -->
        <Button
            android:id="@+id/floatingBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enable Floating Widget" />

        <Button
            android:id="@+id/exitBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/exit_red"
            android:text="Exit App" />

    </LinearLayout>
</ScrollView>
